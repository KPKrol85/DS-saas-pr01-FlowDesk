# Line-ending policy for FlowDesk
# Repository stores text as LF; Windows launchers keep CRLF.

# Default: detect text files and store/check out with LF
* text=auto eol=lf

# Windows launchers must keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets (never line-ending converted, never diffed as text)
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
